&lt;p>Mojo module &lt;a href="https://github.com/ExtraMojo/ExtraMojo/blob/main/extramojo/bstr/bstr.mojo" target="_blank" rel="noopener">🡭&lt;/a>&lt;/p>
&lt;h1>&lt;code>bstr&lt;/code>&lt;/h1>&lt;h2>Aliases&lt;span class="hx-absolute -hx-mt-20" id="aliases">&lt;/span>
&lt;a href="#aliases" class="subheading-anchor" aria-label="Permalink for this section">&lt;/a>&lt;/h2>&lt;ul>
&lt;li>&lt;code>SIMD_U8_WIDTH = simd_width_of[DType.uint8]()&lt;/code>&lt;/li>
&lt;li>&lt;code>CAPITAL_A = SIMD(SIMDLength(ord(StringSpan(&amp;quot;A&amp;quot;))))&lt;/code>&lt;/li>
&lt;li>&lt;code>CAPITAL_Z = SIMD(SIMDLength(ord(StringSpan(&amp;quot;Z&amp;quot;))))&lt;/code>&lt;/li>
&lt;li>&lt;code>LOWER_A = SIMD(SIMDLength(ord(StringSpan(&amp;quot;a&amp;quot;))))&lt;/code>&lt;/li>
&lt;li>&lt;code>LOWER_Z = SIMD(SIMDLength(ord(StringSpan(&amp;quot;z&amp;quot;))))&lt;/code>&lt;/li>
&lt;li>&lt;code>ASCII_CASE_MASK = SIMD(32)&lt;/code>&lt;/li>
&lt;li>&lt;code>ZERO = SIMD(0)&lt;/code>&lt;/li>
&lt;/ul>
